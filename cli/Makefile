routerkeygen-cli.app/Contents/PkgInfo: 
	@test -d routerkeygen-cli.app/Contents || mkdir -p routerkeygen-cli.app/Contents
	@$(DEL_FILE) routerkeygen-cli.app/Contents/PkgInfo
	@echo "APPL????" > routerkeygen-cli.app/Contents/PkgInfo
routerkeygen-cli.app/Contents/Info.plist: 
	@test -d routerkeygen-cli.app/Contents || mkdir -p routerkeygen-cli.app/Contents
	@$(DEL_FILE) routerkeygen-cli.app/Contents/Info.plist
